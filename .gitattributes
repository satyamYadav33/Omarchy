# Auto detect text files and perform LF normalization
* text=auto

# Explicit text files with LF
*.sh text eol=lf
*.bash text eol=lf
*.lua text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Windows scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.svg text
