{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "blue",
      "2": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    {
      "type": "custom",
      "key": "Agent",
      "output": "Claude 3.5 Sonnet (Omarchy Citizen)"
    },
    {
      "type": "custom",
      "key": "Theme",
      "output": "Tokyo Night"
    },
    {
      "type": "custom",
      "key": "Footprint",
      "output": "Micro-Distro (< 10MB overhead)"
    },
    "break",
    "colors"
  ]
}
