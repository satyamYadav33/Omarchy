#!/usr/bin/env bash
# Omarchy Agentic OS - AI Coding Agent Dispatcher
set -eo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
mkdir -p "$STATE_DIR"
CURRENT_AGENT_FILE="$STATE_DIR/default-agent"

AGENTS=("claude" "gemini" "copilot" "grok" "ollama")

get_agent() {
  cat "$CURRENT_AGENT_FILE" 2>/dev/null || echo "claude"
}

list_agents() {
  current=$(get_agent)
  echo -e "\033[1;36mOmarchy Pre-wired Coding Agents:\033[0m"
  echo "  claude    - Anthropic Claude 3.5 Sonnet / Claude Code"
  echo "  gemini    - Google Gemini 1.5 Pro / Advanced Agent"
  echo "  copilot   - GitHub Copilot CLI"
  echo "  grok      - xAI Grok CLI"
  echo "  ollama    - Local Llama 3.3 offline model runner"
  echo ""
  echo -e "Active default agent: \033[1;32m$current\033[0m"
  echo "Switch agent with: omarchy agent set <name>"
}

set_agent() {
  local agent="$1"
  if [[ -z "$agent" ]]; then
    echo "Usage: omarchy agent set <agent-name>" >&2
    exit 1
  fi

  echo "$agent" > "$CURRENT_AGENT_FILE"
  echo -e "\033[1;32m✔ Default Omarchy coding agent set to:\033[0m \033[1;36m$agent\033[0m"
}

launch_agent() {
  local agent="${1:-$(get_agent)}"
  echo -e "\033[1;35m▲ Launching Omarchy Agent: $agent\033[0m"

  if command -v "$agent" >/dev/null 2>&1; then
    exec "$agent"
  else
    echo "Notice: CLI binary '$agent' is not installed on host PATH."
    echo ""
    echo "Quick installation instructions:"
    case "$agent" in
      claude)
        echo "  npm install -g @anthropic-ai/claude-code"
        ;;
      gemini)
        echo "  npm install -g @google/gemini-cli"
        ;;
      copilot)
        echo "  gh extension install github/gh-copilot"
        ;;
      ollama)
        echo "  curl -fsSL https://ollama.com/install.sh | sh"
        ;;
    esac
    echo ""
    echo "Simulating Omarchy agent prompt:"
    echo -e "\033[1;34m[$agent@omarchy]: Ready for coding instructions. Type your request:\033[0m"
    read -r prompt
    echo -e "\033[1;32mProcessing task with $agent...\033[0m"
    echo "Task received: '$prompt'"
    echo "Completed successfully in Omarchy environment."
  fi
}

case "$1" in
  list)
    list_agents
    ;;
  set)
    set_agent "$2"
    ;;
  launch|"")
    launch_agent "$2"
    ;;
  *)
    if [[ " ${AGENTS[*]} " =~ " $1 " ]]; then
      set_agent "$1"
    else
      launch_agent "$1"
    fi
    ;;
esac
