#!/usr/bin/env bash
# Omarchy System Info & Fastfetch Display
set -eo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
THEME=$(cat "$STATE_DIR/current-theme" 2>/dev/null || echo "tokyo-night")
AGENT=$(cat "$STATE_DIR/default-agent" 2>/dev/null || echo "claude")

# Terminal Colors
C_CYAN="\033[1;36m"
C_BLUE="\033[1;34m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_MAGENTA="\033[1;35m"
C_RESET="\033[0m"

cat << EOF
${C_CYAN}                 ▄▄▄
 ▄█████▄    ▄███████████▄    ▄███████   ▄███████   ▄███████   ▄█   █▄    ▄█   █▄
███   ███  ███   ███   ███  ███   ███  ███   ███  ███   ███  ███   ███  ███   ███
███   ███  ███   ███   ███  ███   ███  ███   ███  ███   █▀   ███   ███  ███   ███
███   ███  ███   ███   ███ ▄███▄▄▄███ ▄███▄▄▄██▀  ███       ▄███▄▄▄███▄ ███▄▄▄███
███   ███  ███   ███   ███ ▀███▀▀▀███ ▀███▀▀▀▀    ███      ▀▀███▀▀▀███  ▀▀▀▀▀▀███
███   ███  ███   ███   ███  ███   ███ ██████████  ███   █▄   ███   ███  ▄██   ███
███   ███  ███   ███   ███  ███   ███  ███   ███  ███   ███  ███   ███  ███   ███
 ▀█████▀    ▀█   ███   █▀   ███   █▀   ███   ███  ███████▀   ███   █▀    ▀█████▀
                                       ███   █▀${C_RESET}

${C_CYAN}OS:${C_RESET} Omarchy Linux (Micro-Distro Edition for WSL/Containers)
${C_CYAN}Host:${C_RESET} Windows Subsystem for Linux (WSL2)
${C_CYAN}Kernel:${C_RESET} $(uname -r)
${C_CYAN}Uptime:${C_RESET} $(uptime -p 2>/dev/null || echo "active")
${C_CYAN}Shell:${C_RESET} $SHELL
${C_CYAN}Active Theme:${C_RESET} ${C_YELLOW}${THEME}${C_RESET}
${C_CYAN}Default Agent:${C_RESET} ${C_GREEN}${AGENT} (Anthropic / Claude Code)${C_RESET}
${C_CYAN}Disk Footprint:${C_RESET} ${C_GREEN}< 10 MB (99.9% saved vs 30GB raw ISO)${C_RESET}

EOF
